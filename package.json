{
  "name": "@ryuu-64/dsh-answered-questions",
  "version": "0.1.5",
  "description": "Review answered questions in DeepSeek Harness (DSH): keep all options, selected answers, and free text visible, including dsh-choice cards.",
  "type": "module",
  "license": "MIT",
  "author": "Ryuu-64",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "docs/compatibility.md",
    "docs/development.md",
    "docs/screenshots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryuu-64/dsh-answered-questions.git"
  },
  "homepage": "https://github.com/Ryuu-64/dsh-answered-questions#readme",
  "bugs": {
    "url": "https://github.com/Ryuu-64/dsh-answered-questions/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "questions",
    "choices",
    "answers",
    "conversation-history"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:build": "node scripts/build-client.mjs --check",
    "test": "node --test test/*.test.mjs",
    "check": "npm run check:build && node --check lib/index.js && node --check lib/client.js && npm test",
    "prepack": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.3 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.2.1-rc.3 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3 || 0.2.2-rc.3 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3 || 0.2.2-rc.3 || 0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
